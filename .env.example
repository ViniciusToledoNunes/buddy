# Never commit real keys. Cloud audio is used only when asr_mode is cloud-fast.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required before cloud-fast is allowed to transmit meeting audio.
MEETING_AGENT_ALLOW_CLOUD_AUDIO=false
# Optional: permits MCP start only when the tool also receives confirmed=true.
MEETING_COPILOT_ALLOW_MCP_START=false
