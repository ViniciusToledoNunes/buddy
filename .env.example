# Never commit real keys. Audio is transcribed locally and never leaves this machine.
# Only meeting text -- transcript, memory, and project excerpts -- reaches the model.
ANTHROPIC_API_KEY=

# Optional: point Buddy at a local Ollama server instead of Claude.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: allow the MCP server to start a recording. Off by default.
BUDDY_ALLOW_MCP_START=false
